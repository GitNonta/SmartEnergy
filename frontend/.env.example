# Frontend Environment Variables

# MQTT Broker Configuration
REACT_APP_MQTT_BROKER_HOST=202.29.50.41
REACT_APP_MQTT_BROKER_PORT=9001
REACT_APP_MQTT_WS_PATH=/mqtt
REACT_APP_MQTT_PROTOCOL=ws

# MQTT Authentication (if required)
REACT_APP_MQTT_USERNAME=your_username
REACT_APP_MQTT_PASSWORD=your_password

# MQTT Topics
REACT_APP_MQTT_TOPIC_DATA=AI205/data
REACT_APP_MQTT_TOPIC_ALERTS=AI205/alerts
REACT_APP_MQTT_TOPIC_STATUS=AI205/status
REACT_APP_MQTT_TOPIC_COMMANDS=AI205/commands

# Application Settings
REACT_APP_AUTO_CONNECT=true
REACT_APP_RECONNECT_PERIOD=5000
REACT_APP_CONNECT_TIMEOUT=30000

# Data Retention (in hours)
REACT_APP_HISTORY_RETENTION_HOURS=24

# Gemini AI API Configuration
REACT_APP_GEMINI_API_KEY=your_gemini_api_key_here
