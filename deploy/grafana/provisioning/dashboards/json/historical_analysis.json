                    "datasource": {
                        "type": "influxdb",
                        "uid": "influxdb_raw"
                    },
                    "query": "import \"timezone\"\nimport \"date\"\noption location = timezone.location(name: \"Asia/Bangkok\")\n\ntodayStart = date.truncate(t: now(), unit: 1d)\nqueryStart = date.sub(from: todayStart, d: 2h)\n\nfrom(bucket: \"AI205_raw\")\n  |> range(start: queryStart)\n  |> filter(fn: (r) => r._measurement == \"energy_3phase\")\n  |> filter(fn: (r) => r._field == \"power_active_kw\")\n  |> aggregateWindow(every: 1m, fn: mean, createEmpty: true)\n  |> fill(usePrevious: true)\n  |> map(fn: (r) => ({ r with _value: r._value / 60.0 }))\n  |> filter(fn: (r) => r._time >= todayStart)\n  |> aggregateWindow(every: 1h, fn: sum, createEmpty: false)",
