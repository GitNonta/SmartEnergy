# SMART Energy Monitoring System - Production Environment Variables
# คัดลอกไฟล์นี้ไปเป็น .env ในโฟลเดอร์ backend/

# ===========================================
# InfluxDB Configuration
# ===========================================
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your-influxdb-token-here
INFLUXDB_ORG=Ennergy
INFLUXDB_BUCKET=AI205_raw

# ===========================================
# MQTT Broker Configuration
# ===========================================
MQTT_BROKER_HOST=202.29.50.41
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=energy/AI205

# ===========================================
# Server Configuration
# ===========================================
NODE_ENV=production
PORT=3001
FRONTEND_URL=http://your-domain.com

# For localhost testing
# FRONTEND_URL=http://localhost:3000

# ===========================================
# Security Configuration
# ===========================================
# JWT Secret for API authentication (if implemented)
JWT_SECRET=your-super-secret-jwt-key-here

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://your-domain.com

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# Database Configuration
# ===========================================
# InfluxDB Retention Policies
RETENTION_POLICY_RAW=30d
RETENTION_POLICY_HOURLY=365d
RETENTION_POLICY_DAILY=5y

# ===========================================
# Monitoring & Logging
# ===========================================
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log
ENABLE_REQUEST_LOGGING=true

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30000

# ===========================================
# Performance Configuration
# ===========================================
# WebSocket Configuration
WS_MAX_CONNECTIONS=100
WS_HEARTBEAT_INTERVAL=30000

# MQTT Configuration
MQTT_RECONNECT_PERIOD=5000
MQTT_KEEP_ALIVE=60

# Memory Limits
NODE_OPTIONS=--max-old-space-size=2048

# ===========================================
# Email Notifications (Optional)
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL=admin@your-domain.com

# ===========================================
# Backup Configuration (Optional)
# ===========================================
BACKUP_ENABLED=true
BACKUP_INTERVAL=86400000
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=./backups