# MySQL/MariaDB Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_password_here
DB_NAME=AI205

# JWT Configuration
JWT_SECRET=your_jwt_secret_here_change_in_production

# Session Configuration
SESSION_SECRET=your_session_secret_here

# MQTT Broker Configuration
MQTT_BROKER_HOST=202.29.50.41
MQTT_BROKER_PORT=1883
MQTT_PROTOCOL=mqtt
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password

# MQTT Topics
MQTT_TOPIC_DATA=AI205/data
MQTT_TOPIC_ALERTS=AI205/alerts
MQTT_TOPIC_STATUS=AI205/status
MQTT_TOPIC_COMMANDS=AI205/commands

# WebSocket Server Configuration
WS_PORT=8080
WS_HOST=0.0.0.0

# Express Server Configuration
PORT=3001
HOST=0.0.0.0

# Application Settings
AUTO_CONNECT=true
RECONNECT_PERIOD=5000
CONNECT_TIMEOUT=30000
HISTORY_RETENTION_HOURS=24

# CORS Settings (Frontend URL)
FRONTEND_URL=http://localhost:3000

# Downsampling Scheduler
# Enable/disable the periodic downsampling scheduler and set its interval in minutes
DOWNSAMPLING_ENABLED=true
DOWNSAMPLING_INTERVAL_MINUTES=60

# Timezone
# Server-local timezone for logging and local timestamps (e.g., Asia/Bangkok)
TIMEZONE=Asia/Bangkok

# FTP Server Configuration (for firmware uploads)
FTP_HOST=202.29.50.41
FTP_USER=s6710886217
FTP_PASSWORD=nkey5632
FTP_REMOTE_PATH=/firmware

# MQTT Firmware Topic
MQTT_FW_TOPIC=AI205/firmware/info

# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
