{
  "info": {
    "name": "Smart Energy API Test Suite",
    "_postman_id": "smart-energy-api-tests",
    "description": "Comprehensive API testing for Smart Energy Monitoring System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "deviceId",
      "value": "AI205",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health & Status",
      "item": [
        {
          "name": "Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has status field', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('status');",
                  "});",
                  "",
                  "pm.test('Response time is less than 200ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(200);",
                  "});",
                  "",
                  "pm.test('Content-Type is application/json', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "API Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Has WebSocket client count', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.websocket).to.have.property('connectedClients');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "status"]
            }
          }
        }
      ]
    },
    {
      "name": "Energy APIs",
      "item": [
        {
          "name": "Daily Energy Realtime",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has success field', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('success');",
                  "});",
                  "",
                  "pm.test('Response has daily energy value', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('daily');",
                  "    pm.expect(jsonData.daily).to.be.a('number');",
                  "});",
                  "",
                  "pm.test('Has dataPoints count', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('dataPoints');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/energy/daily-realtime?deviceId={{deviceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "energy", "daily-realtime"],
              "query": [
                {
                  "key": "deviceId",
                  "value": "{{deviceId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Energy Summary",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has success field', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('success');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/energy/summary?timeRange=1D&deviceId={{deviceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "energy", "summary"],
              "query": [
                {
                  "key": "timeRange",
                  "value": "1D"
                },
                {
                  "key": "deviceId",
                  "value": "{{deviceId}}"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Data APIs",
      "item": [
        {
          "name": "History Data",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is array', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/data/history?range=-1h&deviceId={{deviceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "data", "history"],
              "query": [
                {
                  "key": "range",
                  "value": "-1h"
                },
                {
                  "key": "deviceId",
                  "value": "{{deviceId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Recent Data",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has data', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.not.be.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/data/recent?deviceId={{deviceId}}&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "data", "recent"],
              "query": [
                {
                  "key": "deviceId",
                  "value": "{{deviceId}}"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Statistics",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/data/statistics?range=-24h&deviceId={{deviceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "data", "statistics"],
              "query": [
                {
                  "key": "range",
                  "value": "-24h"
                },
                {
                  "key": "deviceId",
                  "value": "{{deviceId}}"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Security Tests",
      "item": [
        {
          "name": "Authentication Check (Should Fail)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('SECURITY ISSUE: No authentication required', function () {",
                  "    // This should FAIL with 401 but currently passes with 200",
                  "    pm.expect(pm.response.code).to.equal(401);",
                  "});",
                  "",
                  "pm.test('Response should require authentication', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('error');",
                  "    pm.expect(jsonData.error).to.include('authentication');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "status"]
            }
          }
        },
        {
          "name": "SQL Injection Test",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Server handles malicious input', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 422]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/data/history?range='; DROP TABLE users; --&deviceId={{deviceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "data", "history"],
              "query": [
                {
                  "key": "range",
                  "value": "'; DROP TABLE users; --"
                },
                {
                  "key": "deviceId",
                  "value": "{{deviceId}}"
                }
              ]
            }
          }
        },
        {
          "name": "XSS Test",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Server sanitizes XSS input', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 422]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/data/history?range=-1h&deviceId=<script>alert('XSS')</script>",
              "host": ["{{baseUrl}}"],
              "path": ["api", "data", "history"],
              "query": [
                {
                  "key": "range",
                  "value": "-1h"
                },
                {
                  "key": "deviceId",
                  "value": "<script>alert('XSS')</script>"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "MQTT Commands",
      "item": [
        {
          "name": "Publish MQTT Message",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('SECURITY ISSUE: No authentication on POST', function () {",
                  "    // This is a CRITICAL security issue",
                  "    pm.expect(pm.response.code).to.equal(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topic\": \"AI205/commands\",\n  \"payload\": {\n    \"command\": \"test\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/mqtt/publish",
              "host": ["{{baseUrl}}"],
              "path": ["api", "mqtt", "publish"]
            }
          }
        }
      ]
    }
  ]
}
